    "CreateViewSql": "select\r\n    h.ID,\r\n    h.評価者,\r\n    h.評価日,\r\n    h.評価分類,\r\n    h.判定1_1,\r\n    h.判定1_2,\r\n    h.判定1_3,\r\n    h.判定1_4,\r\n    h.判定2_1,\r\n    h.判定2_2,\r\n    h.判定2_3,\r\n    h.判定2_4,\r\n    h.等級,\r\n    h.FGC_CreateDate,\r\n    h.FGC_LastModifier,\r\n    h.FGC_LastModifyDate,\r\n    h.FGC_Creator,\r\n    h.FGC_UpdateHelp,\r\n    h.FGC_Rowversion,\r\n    h.FGC_AssignTo,\r\n    h.FGC_State,\r\n    h.規格文書ID,\r\n    w.[ID] AS HistoryID,\r\n    w.[RecordId],\r\n    w.[Who],\r\n    w.[When],                   \r\n    w.[ActionName],\r\n    w.[Comments],            \r\n    w.[FGC_State] AS WorkflowState\r\nfrom\r\n    YBS褒賞_FGC_WHT w\r\nINNER JOIN \r\n    YBS褒賞 h  ON w.[RecordId] = h.ID",
